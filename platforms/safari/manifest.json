{
  "manifest_version": 3,
  "name": "Explore Playlist Gen",
  "version": "0.0.0",
  "description": "Captures song info from the posts Instagram loads in your browser while you browse Explore, and turns it into a Spotify playlist.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*",
    "http://127.0.0.1/*",
    "https://developer.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Explore Playlist Gen",
    "default_popup": "sidepanel.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://developer.spotify.com/dashboard*"
      ],
      "js": [
        "spotify-dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
