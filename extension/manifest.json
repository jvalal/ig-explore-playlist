{
  "manifest_version": 3,
  "name": "Explore Finds (test build)",
  "version": "0.10.1",
  "key": "",
  "description": "Captures song info from the posts Instagram loads in your browser while you browse Explore, and turns it into a Spotify playlist.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Explore finds"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://developer.spotify.com/dashboard*"
      ],
      "js": [
        "spotify-dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
